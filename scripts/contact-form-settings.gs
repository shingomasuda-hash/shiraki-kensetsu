/**
 * 白木建設 採用LP お問い合わせフォーム ─ 設定ファイル
 *
 * ★ このファイルだけを書き換えてください。
 * ★ スクリプト本体（コード.gs）を貼り替えても、このファイルは触らないでください。
 *   設定が消えないよう、本体とは別のファイルに分けてあります。
 *
 * Apps Script での作り方:
 *   左の「ファイル」の「＋」→「スクリプト」→ 名前を「設定」にして、
 *   この内容を貼り付けてください。
 */

/**
 * 控え（バックアップ）用のスクリプトなら true にしてください。
 * 控え側は通知メールを送りません（本番と二重に届くのを避けるため）。
 * お問い合わせくださった方への自動返信は、控え側でも送ります。
 */
var IS_BACKUP = false;

/**
 * 通知メールの宛先。カンマ区切りで複数指定できます。
 *   例: var NOTIFY_TO = 'saiyo@example.co.jp,tanto@example.co.jp';
 * 控え側（IS_BACKUP = true）では空のままで構いません。
 */
var NOTIFY_TO = '';

/**
 * Vercel の環境変数 CONTACT_SHARED_SECRET と同じ文字列。
 * URLを知っているだけの第三者からの送信を防ぎます。空にすると認証なしになります。
 */
var SHARED_SECRET = '';

/** 書き込み先シート名。無ければ自動で作成します。 */
var SHEET_NAME = 'お問い合わせ';

/** メールの差出人名 */
var SENDER_NAME = '白木建設株式会社 採用担当';

/** 自動返信メールの署名 */
var COMPANY_SIGNATURE = [
  '────────────────────',
  '白木建設株式会社 採用担当',
  '────────────────────',
].join('\n');
