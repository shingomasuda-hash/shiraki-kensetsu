# ---------------------------------------------------------------------------
# 白木建設 採用LP 環境変数
# 未設定（空欄）でもビルドは成功します。
# 未設定のリンク・動画・フォーム送信はレンダリングされない／無効化されます。
# ---------------------------------------------------------------------------

# 本番公開URL（未設定の場合、canonical/OGPのURLは出力されません）
NEXT_PUBLIC_SITE_URL=

# 白木建設株式会社 コーポレートサイト（ヘッダー／フッターのロゴリンク先）
NEXT_PUBLIC_CORPORATE_URL=

# --- フッターリンク --------------------------------------------------------
# ヘッダーナビと、フッターの「代表者メッセージ/会社概要/募集職種一覧/先輩インタビュー」は
# ページ内リンクに変更したため、環境変数は不要です。
# 以下はLP内に対応するセクションがないため、外部リンクのまま残しています。
NEXT_PUBLIC_OFFICES_URL=
NEXT_PUBLIC_BENEFITS_URL=
NEXT_PUBLIC_PRIVACY_POLICY_URL=
NEXT_PUBLIC_SITEMAP_URL=

# --- 動画枠 ----------------------------------------------------------------
# 4枠とも src/config/videos.ts で既定の動画を割り当て済みです
# （YouTube限定公開／Shorts＝縦型9:16）。
# ここに値を入れると、そちらが優先されます（枠ごとに個別に差し替え可能）。
# YouTube（限定公開URLでも可）を入れると youtube-nocookie の埋め込みで再生されます。
#   例: https://youtu.be/xxxxxxxxxxx
#       https://www.youtube.com/watch?v=xxxxxxxxxxx
#       https://youtube.com/shorts/xxxxxxxxxxx
# Googleドライブのファイル共有URLを入れると preview 埋め込みになります。
# それ以外のURL（.mp4 等）を入れると <video> による直接再生になります。
#   例: https://cdn.example.com/movie/company.mp4
#
# 動画の比率はURLから判定します（Shorts は縦型9:16、それ以外は16:9）。
# 枠と比率が近ければ枠を埋め、大きく違えば枠内へ収めます。

# 会社紹介動画（現場監督の仕事とは？セクション）
NEXT_PUBLIC_COMPANY_VIDEO_URL=
# 社員インタビュー（キャリアプランセクション）
NEXT_PUBLIC_EMPLOYEE_INTERVIEW_VIDEO_URL=
# 実際の現場一日紹介（先輩社員の1日セクション／PCは縦長枠）
NEXT_PUBLIC_DAILY_ROUTINE_VIDEO_URL=
# 社長・社員座談会（社長からのメッセージセクション）
NEXT_PUBLIC_PRESIDENT_VIDEO_URL=

# --- お問い合わせフォーム --------------------------------------------------
# 入力内容を JSON (POST) で受け取るエンドポイント。
# 未設定の場合、送信ボタンは無効化されます（誤送信防止）。
NEXT_PUBLIC_CONTACT_ENDPOINT=
